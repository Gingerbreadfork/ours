# Copy to /etc/ours/env, mode 0600, and fill in what you use.
# One NAME=value per line, no quotes. These override ours.toml.

# Discord bot token.
OURS_DISCORD_TOKEN=

# Slack bot token (xoxb-) and app-level token (xapp-).
#OURS_SLACK_BOT_TOKEN=
#OURS_SLACK_APP_TOKEN=

# API key for the model endpoint, if it needs one.
#OURS_MODEL_API_KEY=

# A fixed admin token keeps the admin link the same across restarts.
# Letters, digits, - _ . ~ only.
#OURS_ADMIN_TOKEN=

# Mail passwords, when [mail.smtp] and [mail.imap] are in the config
# with password = "".
#OURS_SMTP_PASSWORD=
#OURS_IMAP_PASSWORD=

# Log level.
#RUST_LOG=info
