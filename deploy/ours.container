# Podman quadlet. Copy to /etc/containers/systemd/ours.container, then
#   systemctl daemon-reload && systemctl start ours
# Put data_dir = "/data" in /etc/ours/ours.toml and the tokens in
# /etc/ours/env (see env.example).
[Unit]
Description=Ours, the group agent
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/gingerbreadfork/ours:0.1.0-rc.2
ContainerName=ours
Volume=/etc/ours/ours.toml:/etc/ours/ours.toml:ro,Z
Volume=ours-data:/data:U
EnvironmentFile=/etc/ours/env
# The admin page is plain HTTP behind a token, on every interface so a
# phone on the LAN can reach it. Behind a TLS proxy, publish it on
# loopback instead: PublishPort=127.0.0.1:7777:7777
PublishPort=7777:7777
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
StopSignal=SIGINT
StopTimeout=30

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
